{
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2024",
    "lib": ["es2024"],
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src", "tests"],
  "exclude": [
    "src/client",
    "tests/pool-render-helpers.tsx",
    "tests/pool-render.spec.tsx",
    "tests/pool-card-render.spec.tsx",
    "tests/probe-age.spec.tsx",
    "tests/remaining.spec.tsx",
    "tests/off-thinking-card.spec.tsx",
    "tests/context-tiers.spec.tsx",
    "tests/card-credits-switch.spec.tsx",
    "tests/image-tool-optin.spec.ts",
    "tests/issue101-context-overflow.spec.ts",
    "tests/tps.spec.ts",
    "tests/channel-perturbation-memory.spec.ts",
    "tests/composer-credits-gate.spec.ts",
    "tests/composer-credits-render.spec.tsx",
    "tests/issue46-namespace-binding.spec.tsx",
    "tests/refresh-after-mutation.spec.tsx",
    "tests/oauth-wording.spec.tsx",
    "tests/oauth-auto-open.spec.tsx",
    "tests/issue51-sync-veil.spec.tsx",
    "tests/issue62-credit-position.spec.tsx",
    "tests/issue63-quota-notice.spec.tsx",
    "tests/card-model-sweep.spec.tsx",
    "tests/composer-panel-freshness.spec.tsx",
    "tests/issue77-card-first-paint.spec.tsx",
    "tests/promo-card.spec.tsx",
    "tests/promo-badge.spec.ts",
    "tests/card-panels.spec.tsx"
  ]
}
